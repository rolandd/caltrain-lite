{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@packages/*": ["../../packages/*"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["src/service-worker"]
}
