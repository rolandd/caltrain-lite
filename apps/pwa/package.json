{
  "name": "pwa",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "generate": "pnpm --filter @transit/scripts run generate",
    "test": "vitest run",
    "test:all": "vitest run && pnpm run check:theme && pnpm run check:a11y",
    "predev": "pnpm run generate",
    "dev": "vite dev",
    "prebuild": "pnpm run generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint:workspace": "pnpm -w run lint -- apps/pwa",
    "lint": "pnpm run lint:workspace && pnpm run check:tailwind-colors && pnpm run check:theme && pnpm run check:a11y",
    "check:tailwind-colors": "node scripts/check-tailwind-arbitrary-colors.mjs",
    "check:theme": "node scripts/check-theme-contrast.mjs",
    "check:a11y": "node scripts/check-a11y-standards.mjs",
    "format": "pnpm -w run format -- apps/pwa",
    "format:check": "pnpm -w run format:check -- apps/pwa",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm run check:sw",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:sw": "tsc --project src/service-worker"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@typia/unplugin": "^12.1.1",
    "fast-check": "^4.10.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-devtools-json": "^1.1.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "dexie": "^4.4.7",
    "typia": "^12.2.1"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
